<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>thegate</groupId>
    <artifactId>The_Gate</artifactId>
    <version>3.0.6mc26.2-spig</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            NOTE for Tony: pin these to the exact latest tags before building.
            I could not fetch repo.papermc.io / repo.codemc.io / the EntityLib maven
            host from my sandbox (not on my network allowlist), so I could not verify
            these resolve. Your machine has normal internet access, so:
              - paper-api: check https://docs.papermc.io/paper/dev/project-setup/ for
                the current recommended version string for 26.2 (range below should work).
              - packetevents: check https://github.com/retrooper/packetevents/releases
                for the latest version (2.13.0 was current as of this writing, and
                explicitly added 26.2 support).
              - entitylib: check https://github.com/Tofaa2/EntityLib for the latest
                release tag/version and confirm the correct groupId (it has moved
                between com.github.Tofaa2.EntityLib on JitPack and io.github.tofaa2
                on their own maven host at maven.pvphub.me/tofaa - use whichever the
                README currently documents).
        -->
        <packetevents.version>2.13.0</packetevents.version>
        <entitylib.version>3.3.6-SNAPSHOT</entitylib.version>
    </properties>

    <repositories>
        <!-- Paper API -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PacketEvents -->
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <!-- EntityLib (JitPack mirror - fallback if the pvphub maven host below doesn't work) -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <!-- EntityLib (current official host per their README) -->
        <repository>
            <id>pvphub-tofaa</id>
            <url>https://maven.pvphub.me/tofaa</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.2.build,)</version>
            <scope>provided</scope>
        </dependency>

        <!-- SPIGOT VARIANT: packetevents-spigot is 'provided', not shaded. Users must separately
             install the PacketEvents plugin. This avoids a real, hard version conflict between what
             Paper 26.2 needs to compile against (Adventure 5.x) and what packetevents-spigot:2.13.0's
             own compiled BukkitLogManager class expects internally (an older Adventure API shape) -
             see the long story in pom.xml history/CHANGES.md. Running PacketEvents standalone puts
             its internals in their own classloader, completely isolated from our own bundled
             Adventure/EntityLib classes, so there's no more conflict to resolve. -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>${packetevents.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- EntityLib - confirmed via maven-metadata.xml at maven.pvphub.me/tofaa -->
        <dependency>
            <groupId>io.github.tofaa2</groupId>
            <artifactId>spigot</artifactId>
            <version>${entitylib.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- MySQL/SQLite drivers - the original plugin used these for DatabaseManager.
             Keeping provided/compile scope consistent with how it shipped originally;
             adjust if you shade a JDBC driver in yourself. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Adventure: Paper bundles this in the server itself, so it was previously working there
             "for free" via paper-api's own (provided-scope) transitive dependency. Plain Spigot does
             NOT include Adventure at all, so it must be bundled into our own jar to run there.
             SPIGOT VARIANT: back to 5.2.0 (matching Paper's own version) now that packetevents-spigot
             is 'provided' (standalone plugin) instead of shaded. The earlier NoClassDefFoundError
             (missing net.kyori.adventure.util.Buildable$Builder) was caused by packetevents-spigot's
             own compiled BukkitLogManager class expecting an older Adventure API shape than 5.2.0
             provides - a real incompatibility in that specific prebuilt jar. Since PacketEvents no
             longer ships inside our jar, its internals run in their own classloader with their own
             correctly-matched Adventure copy, completely isolated from ours. No more conflict.
             This IS relocated (see the net.kyori relocation rule in the shade plugin config below) -
             purely as defensive practice, to avoid colliding with whatever Adventure classes any
             other plugin on the server might separately bundle. Maven Shade rewrites references
             consistently across the whole final jar (including our own compiled code and EntityLib's),
             so this relocation doesn't break anything internally. -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>5.2.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>5.2.0</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- Shade EntityLib + Adventure + JDBC drivers into the final jar. PacketEvents is
                 deliberately NOT shaded or relocated in this variant - see the comment on the
                 packetevents-spigot dependency above. EntityLib's own compiled classes reference
                 PacketEvents' real, unrelocated package names (com.github.retrooper.packetevents,
                 io.github.retrooper.packetevents), so those must stay untouched here in order to
                 correctly resolve against the classes provided by the standalone PacketEvents plugin
                 at runtime. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>me.tofaa.entitylib</pattern>
                                    <shadedPattern>thegate.libs.entitylib</shadedPattern>
                                </relocation>
                                <!-- Relocating our own bundled Adventure copy (used by EntityLib and
                                     ArmorStand.java's setCustomName) purely as defensive isolation,
                                     so it can't collide with whatever Adventure classes any other
                                     plugin on the server might separately bundle. This is unrelated to
                                     PacketEvents in this variant, since PacketEvents itself is NOT
                                     shaded here - see the packetevents-spigot dependency comment above
                                     for why. -->
                                <relocation>
                                    <pattern>net.kyori</pattern>
                                    <shadedPattern>thegate.libs.kyori</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- Exclude EntityLib's own (buggy) SpigotEntityIdProvider from the merge -
                                     our own patched replacement at src/main/java/me/tofaa/entitylib/spigot/
                                     takes its place instead. See that file's header comment for the full
                                     explanation of the bug being worked around. -->
                                <filter>
                                    <artifact>io.github.tofaa2:spigot</artifact>
                                    <excludes>
                                        <exclude>me/tofaa/entitylib/spigot/SpigotEntityIdProvider.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
